# Shape of /opt/n8n/.env. On the instance this file is generated at first boot
# (terraform/templates/user_data.sh.tftpl); the two secrets are read from SSM
# Parameter Store. Never commit a real .env.
N8N_VERSION=2.42.6
N8N_HOST=n8n.example.com
ACME_EMAIL=ops@example.com
TIMEZONE=Europe/Paris
AWS_REGION=eu-west-3
BACKUP_BUCKET=n8n-backups-example
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
